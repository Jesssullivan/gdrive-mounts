{
  "schema_version": 1,
  "defaults": {
    "stateDir": "~/.local/state/gdrive-mounts",
    "mountRoot": "~/GDrive",
    "cacheRoot": "/Volumes/TinylandSSD/tinyland/gdrive-cache",
    "cacheMaxSize": "100G",
    "vfsCacheMode": "full",
    "dirCacheTime": "720h",
    "vfsReadAhead": "128M",
    "nfsCacheHandleLimit": 250000,
    "indexStateDir": "~/.local/state/gdrive-index",
    "indexFreshnessSloHours": 24,
    "mountBackendDarwin": "nfsmount",
    "mountBackendLinux": "mount",
    "ioTimeout": "20s",
    "connectTimeout": "10s",
    "lowLevelRetries": 3,
    "attrTimeout": "5s",
    "pollInterval": "5m",
    "logLevel": "INFO",
    "statsInterval": "0",
    "nfsMountOptions": ["soft", "intr", "timeo=100", "retrans=5", "dumbtimer"],
    "remoteControl": true,
    "watchdogEnable": true,
    "watchdogIntervalSec": 60,
    "watchdogProbeTimeoutSec": 10,
    "watchdogFailureThreshold": 2,
    "watchdogRestartFloorSec": 300
  },
  "orgs": [
    {
      "name": "sulliwood",
      "account": "jess@sulliwood.org",
      "enabled": true,
      "driveKind": "mydrive",
      "remote": "gdrive-sulliwood",
      "scope": "drive",
      "promotionTarget": "drive",
      "secretEnvPrefix": "GDM_SULLIWOOD",
      "mounts": [
        {
          "name": "root",
          "remotePath": "",
          "mountSuffix": "sulliwood",
          "note": "One rclone process per org. Whole drive, read-only until an explicit per-org promotion to scope=drive."
        }
      ],
      "links": [
        {
          "name": "gftb-stuff",
          "target": "GFTB Stuff",
          "note": "Initial contract goal (ratified 2026-08-17). Symlink into the root mount, not a second mount."
        }
      ]
    },
    {
      "name": "xoxd",
      "account": "jess@xoxd.ai",
      "enabled": false,
      "driveKind": "mydrive",
      "remote": "gdrive-xoxd",
      "scope": "drive.readonly",
      "promotionTarget": "drive",
      "secretEnvPrefix": "GDM_XOXD",
      "mounts": [],
      "links": []
    },
    {
      "name": "lmux",
      "account": "jess@lmux.ai",
      "enabled": false,
      "driveKind": "mydrive",
      "remote": "gdrive-lmux",
      "scope": "drive.readonly",
      "promotionTarget": "drive",
      "secretEnvPrefix": "GDM_LMUX",
      "mounts": [],
      "links": []
    }
  ]
}
