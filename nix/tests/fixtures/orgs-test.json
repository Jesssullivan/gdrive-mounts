{
  "schema_version": 1,
  "defaults": {
    "stateDir": "~/.local/state/gdrive-mounts",
    "mountRoot": "~/GDrive",
    "cacheRoot": "/Volumes/TinylandSSD/gdrive-cache",
    "cacheMaxSize": "100G",
    "vfsCacheMode": "full",
    "dirCacheTime": "720h",
    "vfsReadAhead": "128M",
    "nfsCacheHandleLimit": 250000,
    "indexStateDir": "~/.local/state/gdrive-index",
    "indexFreshnessSloHours": 24,
    "mountBackendDarwin": "nfsmount",
    "mountBackendLinux": "mount"
  },
  "orgs": [
    {
      "name": "sulliwood",
      "account": "tester@example.org",
      "enabled": true,
      "driveKind": "mydrive",
      "remote": "gdrive-sulliwood",
      "scope": "drive.readonly",
      "promotionTarget": "drive",
      "secretEnvPrefix": "GDM_SULLIWOOD",
      "mounts": [
        {
          "name": "root",
          "remotePath": "",
          "mountSuffix": "sulliwood",
          "note": "Read-only org. Proves --read-only, --volname and the nfs handle limit."
        }
      ],
      "links": [
        {
          "name": "gftb-stuff",
          "target": "GFTB Stuff",
          "note": "Proves the link activation entry, including a target with a space."
        }
      ]
    },
    {
      "name": "rwlab",
      "account": "tester@example.net",
      "enabled": true,
      "driveKind": "shared",
      "teamDriveId": "0ATESTDUMMYSHAREDDRIVE",
      "remote": "gdrive-rwlab",
      "scope": "drive",
      "promotionTarget": "drive",
      "secretEnvPrefix": "GDM_RWLAB",
      "mounts": [
        {
          "name": "root",
          "remotePath": "",
          "mountSuffix": "rwlab",
          "note": "Read-write org. Proves --read-only is absent when scope is drive."
        }
      ],
      "links": []
    },
    {
      "name": "parked",
      "account": "tester@example.com",
      "enabled": false,
      "driveKind": "mydrive",
      "remote": "gdrive-parked",
      "scope": "drive.readonly",
      "promotionTarget": "drive",
      "secretEnvPrefix": "GDM_PARKED",
      "mounts": [],
      "links": []
    }
  ]
}
